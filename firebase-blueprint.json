{
  "entities": {
    "DecisionLogEntry": {
      "title": "DecisionLogEntry",
      "description": "Advisory guardrail evaluation entry logged by an authenticated user for a specific market data window.",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp recorded at write time."
        },
        "source": {
          "type": "string",
          "enum": ["Delta", "Alpaca"],
          "description": "Market data source used for the evaluated candles."
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Instrument or equity ticker symbol."
        },
        "timeframe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Candle resolution and lookback window label."
        },
        "decision": {
          "type": "string",
          "enum": ["CONTINUE", "REDUCE_SIZE", "PAUSE", "NO_DECISION"],
          "description": "Deterministic advisory guardrail decision."
        },
        "firedRules": {
          "type": "array",
          "description": "Named guardrail rule identifiers that triggered."
        },
        "reasons": {
          "type": "array",
          "description": "Quantitative reason strings derived from live metric values and thresholds."
        },
        "inputs": {
          "type": "object",
          "description": "Regime metric inputs evaluated (score, volZ, trend, changePointsInWindow, lastChangePointAgeBars)."
        },
        "thresholdsUsed": {
          "type": "object",
          "description": "Numeric threshold settings used during evaluation."
        },
        "lastCandleTime": {
          "type": "number",
          "description": "Unix timestamp in seconds of the final loaded candle, or null when empty."
        },
        "candleCount": {
          "type": "number",
          "description": "Number of candles loaded in the evaluated window."
        }
      },
      "required": [
        "timestamp",
        "source",
        "symbol",
        "timeframe",
        "decision",
        "firedRules",
        "reasons",
        "inputs",
        "thresholdsUsed",
        "lastCandleTime",
        "candleCount"
      ]
    },
    "PaperAccount": {
      "title": "PaperAccount",
      "description": "Simulated paper trading account snapshot with string-serialized BigInt units and configurable reset timezone.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "symbol": { "type": "string" },
        "resolution": { "type": "string", "enum": ["15m", "1h"] },
        "balanceUnits": { "type": "string" },
        "equityUnits": { "type": "string" },
        "resetTimeZone": { "type": "string" }
      },
      "required": ["sessionId", "uid", "symbol", "resolution", "balanceUnits", "equityUnits", "resetTimeZone"]
    },
    "PaperOrder": {
      "title": "PaperOrder",
      "description": "Simulated paper order keyed by clientOrderId.",
      "type": "object",
      "properties": {
        "clientOrderId": { "type": "string" },
        "sessionId": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "FILLED", "CANCELLED", "REJECTED"] }
      },
      "required": ["clientOrderId", "sessionId", "status"]
    },
    "PaperFill": {
      "title": "PaperFill",
      "description": "Immutable simulated fill keyed by fillId.",
      "type": "object",
      "properties": {
        "fillId": { "type": "string" },
        "clientOrderId": { "type": "string" },
        "feeUnits": { "type": "string" },
        "replayed": { "type": "boolean" }
      },
      "required": ["fillId", "clientOrderId", "feeUnits", "replayed"]
    },
    "PaperPosition": {
      "title": "PaperPosition",
      "description": "Open simulated paper position.",
      "type": "object",
      "properties": {
        "positionId": { "type": "string" },
        "sessionId": { "type": "string" },
        "side": { "type": "string", "enum": ["LONG", "SHORT"] },
        "contracts": { "type": "number" }
      },
      "required": ["positionId", "sessionId", "side", "contracts"]
    },
    "PaperClosedTrade": {
      "title": "PaperClosedTrade",
      "description": "Immutable simulated closed trade journal entry keyed by tradeId.",
      "type": "object",
      "properties": {
        "tradeId": { "type": "string" },
        "sessionId": { "type": "string" },
        "netPnlUnits": { "type": "string" },
        "replayed": { "type": "boolean" }
      },
      "required": ["tradeId", "sessionId", "netPnlUnits", "replayed"]
    },
    "PaperParameterVersion": {
      "title": "PaperParameterVersion",
      "description": "Immutable pinned parameter/guardrail version.",
      "type": "object",
      "properties": {
        "versionId": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["versionId", "label"]
    },
    "HeldOutEvaluationLog": {
      "title": "HeldOutEvaluationLog",
      "description": "Immutable audit record of held-out split evaluations.",
      "type": "object",
      "properties": {
        "logId": { "type": "string" },
        "sessionId": { "type": "string" },
        "inspectionIndex": { "type": "number" }
      },
      "required": ["logId", "sessionId", "inspectionIndex"]
    }
  },
  "firestore": {
    "/users/{uid}/decisions/{docId}": {
      "schema": {
        "$ref": "#/entities/DecisionLogEntry"
      },
      "description": "Per-user advisory guardrail decision log entries owned and accessible solely by request.auth.uid == uid."
    },
    "/users/{uid}/paper/ledger/accounts/{sessionId}": {
      "schema": { "$ref": "#/entities/PaperAccount" },
      "description": "Saved simulated paper account state (event + 60s throttled writes)."
    },
    "/users/{uid}/paper/ledger/orders/{clientOrderId}": {
      "schema": { "$ref": "#/entities/PaperOrder" },
      "description": "Simulated paper orders keyed by clientOrderId."
    },
    "/users/{uid}/paper/ledger/fills/{fillId}": {
      "schema": { "$ref": "#/entities/PaperFill" },
      "description": "Immutable simulated paper fills."
    },
    "/users/{uid}/paper/ledger/positions/{posId}": {
      "schema": { "$ref": "#/entities/PaperPosition" },
      "description": "Open simulated paper positions."
    },
    "/users/{uid}/paper/ledger/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/PaperClosedTrade" },
      "description": "Immutable simulated closed trades."
    },
    "/users/{uid}/paper/ledger/versions/{versionId}": {
      "schema": { "$ref": "#/entities/PaperParameterVersion" },
      "description": "Immutable parameter versions."
    },
    "/users/{uid}/paper/ledger/heldOutLogs/{logId}": {
      "schema": { "$ref": "#/entities/HeldOutEvaluationLog" },
      "description": "Immutable audit log of held-out set inspections."
    }
  }
}
